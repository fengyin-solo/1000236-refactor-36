APP_ENV=local
# 后端监听地址与端口（run.sh / uvicorn）
APP_HOST=127.0.0.1
APP_PORT=8000
# 允许的前端跨域来源，多个用逗号分隔；留空走默认值
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 分页口径（默认页大小、单页上限），由启动管线做环境校验
APP_PAGE_SIZE_DEFAULT=20
APP_PAGE_SIZE_MAX=200
# 前端：默认走 vite 代理（留空即可）；如需直连后端再填 http://127.0.0.1:8000
VITE_API_BASE=
VITE_APP_NAME=影视剧组拍摄制作管理平台
# vite 代理的后端目标
VITE_PROXY_TARGET=http://127.0.0.1:8000
